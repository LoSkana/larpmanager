msgid "Setting"
msgstr "Nastavení"

msgid "Choose the setting for the event"
msgstr "Zvol prostředí pro akci"

msgctxt "event"
msgid "Style"
msgstr "Styl"

msgid "Choose the style for the event"
msgstr "Zvol styl události"

msgid "City / Place"
msgstr "Město / místo"

msgid "City or place of the event"
msgstr "Město nebo místo konání akce"

msgid "Country"
msgstr "Země"

msgid "Country of the event"
msgstr "Země konání akce"

msgid "Accommodation"
msgstr "Ubytování"

msgid "Type of accommodation included"
msgstr "Typ ubytování v ceně"

