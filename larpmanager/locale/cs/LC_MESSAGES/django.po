msgid "Tokens"
msgstr "Žetony"

msgid "Total issued"
msgstr "Vydáno celkem"

msgid "Credits"
msgstr "Kredity"

msgid "Expenses"
msgstr "Výdaje"

msgid "Total of expenses submitted by collaborators and approved"
msgstr "Součet výdajů předložených spolupracovníky a schválených"

msgid "Outflows"
msgstr "Odtoky"

msgid "Total of recorded money outflows"
msgstr "Součet zaznamenaných odlivů peněz"

msgid "Inflows"
msgstr "Příjmy"

msgid "Total of recorded money inflows"
msgstr "Součet zaznamenaných přílivů peněz"

msgid "Income"
msgstr "Příjmy"

msgid "Total participation fees received"
msgstr "Celková výše přijatých účastnických poplatků"

msgid "Transactions"
msgstr "Transakce"

msgid "Total amount withheld for transfer commissions"
msgstr "Celková částka sražená na provize za převod"

msgid "Refunds"
msgstr "Vrácené platby"

msgid "Total amount refunded to participants"
msgstr "Celková částka vrácená účastníkům"

msgid "Discount"
msgstr "Sleva"

msgid "Total participation fees reduced through discounts"
msgstr "Celkové účastnické poplatky snížené díky slevám"

msgid "Registrations"
msgstr "Registrace"

msgid "Expected total income from participation fees selected by participants"
msgstr "Očekávaný celkový příjem z účastnických poplatků vybraných účastníky"

#, python-format
msgid "Registration fee %(number)d of %(user)s per %(event)s"
msgstr "Registrační poplatek %(number)d od %(user)s na %(event)s"

msgid "Annual membership fee"
msgstr "Roční členský poplatek"

#, python-format
msgid "Membership fee of %(user)s for %(year)s"
msgstr "Členský poplatek %(user)s za %(year)s"

#, python-format
msgid "Donation of %(user)s, with reason: '%(reason)s'"
msgstr "Dar od %(user)s, s důvodem: '%(reason)s'"

#, python-format
msgid "Collected contribution of %(user)s for %(recipient)s"
msgstr "Vybraný příspěvek od %(user)s pro %(recipient)s"

msgid "Freely indicate the amount of your donation"
msgstr "Volně uveď výši svého daru"

msgid "Free donation"
msgstr "Dobrovolný příspěvek"

msgid "Available"
msgstr "Dostupné"

msgid "Registrations on external link"
msgstr "Registrace na externím odkazu"

msgid "Pre-registration active"
msgstr "Předběžná registrace aktivní"

msgid "Registrations opening not set"
msgstr "Otevření registrací není nastaveno"

msgid "Registrations open"
msgstr "Registrace jsou otevřeny"

msgid "Reserve registrations"
msgstr "Náhradní registrace"

msgid "Waiting list registrations"
msgstr "Registrace na čekací listině"

msgid "Registration closed"
msgstr "Registrace uzavřena"

#, python-format
msgid "Registrations opening on: %(date)s"
msgstr "Registrace se otevírají: %(date)s"

msgid "Player"
msgstr "Hráč"

msgid "Waiting"
msgstr "Čekání"

msgid "Staff"
msgstr "Zaměstnanci"

msgid "Reserve"
msgstr "Rezerva"

msgid "Seller"
msgstr "Prodejce"

msgid "Lottery"
msgstr "Loterie"

msgid "NPC"
msgstr "NPC"

msgid "Collaborator"
msgstr "Spolupracovník"

msgid "Tot"
msgstr "Celkem"

msgid ""
"Track your personal expense reimbursement requests submitted for this event"
msgstr ""
"Sleduj své žádosti o proplacení osobních výdajů podané v souvislosti s touto "
"akcí"

msgid "Expenses collaborators"
msgstr "Výdaje spolupracovníků"

msgid ""
"Review and approve expense reimbursement requests submitted by collaborators "
"for this event"
msgstr ""
"Zkontroluj a schval žádosti o proplacení výdajů předložené spolupracovníky v "
"souvislosti s touto akcí."

msgid "Manage token assignments issued to participants for this event"
msgstr "Správa přidělení tokenů účastníkům této akce"

msgid "Manage credit assignments issued to participants for this event"
msgstr "Správa přidělení kreditů účastníkům této akce"

msgid "Payments"
msgstr "Platby"

msgid "Track and review event payments, and confirm pending ones"
msgstr ""
"Sleduj a kontroluj platby za akce a potvrzuj ty, které jsou ještě v čekání"

msgid "Manage outgoing payments linked to events"
msgstr "Správa odchozích plateb spojených s událostmi"

msgid "Manage incoming revenue linked to events"
msgstr "Správa příjmů souvisejících s akcemi"

msgid "Donations"
msgstr "Dary"

msgid ""
"Browse all payment invoices and confirm submitted ones to update their status"
msgstr ""
"Prohlédni si všechny platební faktury a potvrď odeslané faktury, aby se "
"aktualizoval jejich stav"

msgid "Manage all credit assignments issued to members across events"
msgstr "Spravuj všechna přidělení kreditů členům v rámci jednotlivých akcí"

msgid "Assignment"
msgstr "Zadání"

msgid "Manage all token assignments issued to members across events"
msgstr ""
"Spravuj všechna přidělení tokenů vydaná členům v rámci jednotlivých akcí"

msgid "Review and approve expense claims submitted by collaborators"
msgstr ""
"Prověřit a schválit žádosti o proplacení výdajů předložené spolupracovníky"

msgid "Description"
msgstr "Popis"

msgid "Collections"
msgstr "Sbírky"

msgid "A member must be selected to mark the collection as paid"
msgstr "Pro označení sbírky jako zaplacené musí být vybrán člen"

msgid "Configure event discounts, discount types, values, and promo codes."
msgstr "Nastav slevy na akce, typy slev, jejich výši a propagační kódy."

msgid "The sessions for which the discount is available"
msgstr "Relace, pro které je sleva k dispozici"

msgid "Upload a PDF file or image (JPG, PNG, etc.)"
msgstr "Nahraj soubor PDF nebo obrázek (JPG, PNG atd.)"

msgid "Payment confirmation"
msgstr "Potvrzení platby"

msgid "I confirm that I have made the payment"
msgstr "Potvrzuji, že jsem provedl/a platbu"

msgid "Info"
msgstr "Informace"

msgid "Enter any useful information for the organizers to verify the payment"
msgstr ""
"Zadej veškeré informace, které jsou pro organizátory užitečné pro ověření "
"platby"

msgid ""
"The amount of reimbursement desired (can't be higher than your current "
"credits)"
msgstr ""
"Požadovaná výše proplacení (nemůže být vyšší než tvoje aktuální kredity)"

msgid "Request refund"
msgstr "Požádat o vrácení"

msgid "Payment Methods"
msgstr "Způsoby platby"

msgid ""
"Enable or disable payment methods available at checkout, and configure "
"credentials for each active payment gateway"
msgstr ""
"Zapni nebo vypni platební metody dostupné při placení a nastav přihlašovací "
"údaje pro každou aktivní platební bránu."

msgid "Description of this payment method shown to the user."
msgstr "Popis této platební metody zobrazený uživateli."

msgid ""
"Percentage retained by the payment system. Enter the value as a number "
"without the percentage symbol."
msgstr ""
"Procento stržené platebním systémem. Zadej hodnotu jako číslo bez symbolu "
"procenta."

msgid "Fee"
msgstr "Poplatek"

msgid "Beneficiary"
msgstr "Příjemce"

msgid "Enter a valid numeric value"
msgstr "Zadej platnou číselnou hodnotu"

msgid "Value must be greater than or equal to 0"
msgstr "Hodnota musí být větší nebo rovna 0"

msgid "Settings"
msgstr "Nastavení"

msgid "Edit the core settings for your organization"
msgstr "Uprav základní nastavení své organizace"

msgid "Texts"
msgstr "Texty"

msgid "Manage custom text blocks displayed on pages and in emails"
msgstr ""
"Správa vlastních textových bloků zobrazených na stránkách a v e-mailech"

msgid "Added at the top of the user profile page"
msgstr "Přidáno v horní části stránky profilu uživatele"

msgid "Added at the top of the main calendar page"
msgstr "Přidáno v horní části hlavní stránky kalendáře"

msgid "Added at the bottom of all emails confirming signups to participants"
msgstr "Přidáno na konec všech e-mailů potvrzujících přihlášení účastníkům"

msgid "Content of the membership request filled with user data"
msgstr "Obsah žádosti o členství vyplněný údaji uživatele"

msgid "Added to the membership page as the paragraph for statute info"
msgstr "Přidáno na stránku členství jako odstavec pro informace o statutu"

msgid "Content of legal notice page linked at the bottom of all pages"
msgstr ""
"Obsah stránky s právním upozorněním, na kterou je odkazováno v dolní části "
"všech stránek"

msgid "Added to the bottom of all pages"
msgstr "Přidáno do spodní části všech stránek"

msgid ""
"Terms and conditions of signup, shown in a page linked in the registration "
"form"
msgstr ""
"Podmínky registrace uvedené na stránce s odkazem v registračním formuláři"

msgid "Added to the bottom of all mails sent"
msgstr "Přidáno na konec všech odeslaných e-mailů"

msgid "Content of privacy page linked at the bottom of all pages"
msgstr ""
"Obsah stránky o ochraně osobních údajů s odkazem v dolní části všech stránek"

msgid ""
"Content of mail reminding participants to fill their membership request."
msgstr ""
"Obsah e-mailu připomínajícího účastníkům, aby vyplnili žádost o členství."

msgid "Content of mail reminding participants to pay the membership fee."
msgstr ""
"Obsah e-mailu připomínajícího účastníkům zaplacení členského příspěvku."

msgid "Content of mail reminding participants to pay their signup fee"
msgstr ""
"Obsah e-mailu, který účastníkům připomíná, aby zaplatili registrační poplatek"

msgid "Content of mail reminding participants to fill their profile"
msgstr "Obsah e-mailu, který účastníkům připomíná, aby vyplnili svůj profil"

msgid "Translations"
msgstr "Překlady"

msgid ""
"Manage custom translation overrides that replace default interface strings "
"for this organization"
msgstr ""
"Spravuj vlastní překlady, které nahrazují výchozí texty rozhraní pro tuto "
"organizaci"

msgid "Roles"
msgstr "Role"

msgid ""
"Manage organization roles, assign members, and configure the permissions "
"granted to each role"
msgstr ""
"Spravuj role v organizaci, přiřazuj členy a nastav oprávnění přidělená "
"jednotlivým rolím"

msgid ""
"If you don't find a user, save the role and then invite them by clicking "
"this symbol:"
msgstr ""
"Pokud uživatele nenajdeš, ulož roli a pak ho pozvi kliknutím na tento symbol:"

msgid "Appearance"
msgstr "Vzhled"

msgid ""
"Customize the visual appearance of your organization by selecting a theme, "
"colors, font, background"
msgstr ""
"Přizpůsob si vzhled své organizace výběrem motivu, barev, písma a pozadí"

msgid "Theme"
msgstr "Téma"

msgid ""
"Freely insert CSS commands, they will be reported in all pages  in the space "
"of your Organization. In this way you can customize freely the appearance."
msgstr ""
"Volně vkládej příkazy CSS, které se zobrazí na všech stránkách v prostoru "
"asociace. Tímto způsobem si můžeš libovolně přizpůsobit vzhled."

msgid "Features"
msgstr "Funkce"

msgid "Enable or disable features for your organization and all its events"
msgstr "Zapni nebo vypni funkce pro tvoji organizaci a všechny její akce"

msgid "Configuration"
msgstr "Konfigurace"

msgid ""
"Fine-tune the behavior of each activated feature by adjusting its "
"configuration options"
msgstr ""
"Uprav chování každé aktivované funkce změnou jejích konfiguračních parametrů"

msgid "Interface"
msgstr "Rozhraní"

msgid "Past events"
msgstr "Minulé události"

msgid "If selected, a link to past events is shown in the calendar."
msgstr "Je-li vybráno, v kalendáři se zobrazí odkaz na minulé akce."

msgid "Characters shortcut"
msgstr "Zkratka postav"

msgid ""
"If selected, the sidebar shows a link to view all of a user's characters."
msgstr ""
"Je-li vybráno, postranní panel zobrazí odkaz pro zobrazení všech postav "
"uživatele."

msgid "Registrations shortcut"
msgstr "Zkratka pro registrace"

msgid ""
"If selected, the sidebar shows a link to view all of a user's registrations."
msgstr ""
"Je-li vybráno, postranní panel zobrazí odkaz pro zobrazení všech registrací "
"uživatele."

msgid "Website"
msgstr "Webové stránky"

msgid "If selected, the website is shown for each event."
msgstr "Je-li vybráno, pro každou akci se zobrazí webová stránka."

msgid "Where"
msgstr "Kde"

msgid "If selected, the location is shown for each event."
msgstr "Je-li vybráno, pro každou akci se zobrazí místo."

msgid "Authors"
msgstr "Autoři"

msgid "If selected, the list of authors is shown for each event."
msgstr "Je-li vybráno, pro každou akci se zobrazí seznam autorů."

msgctxt "event"
msgid "Genre"
msgstr "Žánr"

msgctxt "event"
msgid "If selected, the genre is shown for each event."
msgstr "Je-li vybráno, pro každou akci se zobrazí žánr."

msgid "Tagline"
msgstr "Tagline"

msgid "If selected, the tagline is shown for each event."
msgstr "Je-li vybráno, pro každou akci se zobrazí slogan."

msgid "Bulk delete"
msgstr "Hromadné odstranění"

msgid ""
"If enabled, allows items to be deleted in bulk. WARNING: deleted items might "
"not be fully recoverable."
msgstr ""
"Pokud je povoleno, umožňuje hromadné mazání položek. VAROVÁNÍ: smazané "
"položky nemusí být možné plně obnovit."

msgid "Email notifications"
msgstr "E-mailová oznámení"

msgid "Notifications digest"
msgstr "Přehled oznámení"

msgid ""
"If enabled, receive a single daily summary email instead of immediate "
"notifications for registrations, payments, and invoice approvals."
msgstr ""
"Je-li povoleno, budeš místo okamžitých oznámení o registracích, platbách a "
"schválení faktur dostávat jeden denní souhrnný e-mail."

msgid "Carbon copy"
msgstr "Kopie (CC)"

msgid ""
"If enabled, sends a copy of every email sent to participants to the main "
"email address."
msgstr ""
"Je-li povoleno, odešle se kopie každého e-mailu zaslaného účastníkům na "
"hlavní e-mailovou adresu."

msgid "Interval sending"
msgstr "Intervalové odesílání"

msgid ""
"In seconds, amount of time between each sent email (default: 3, minimum: 1)."
msgstr ""
"Doba v sekundách mezi odesláním jednotlivých e-mailů (výchozí: 3, minimum: "
"1)."

msgid "New signup"
msgstr "Nová registrace"

msgid "If selected, send an email notification to organizers for new signups."
msgstr ""
"Je-li vybráno, odešle se organizátorům e-mailové oznámení o nových "
"registracích."

msgid "Signup update"
msgstr "Aktualizace registrace"

msgid ""
"If selected, send an email notification to organizers for updated signups."
msgstr ""
"Je-li vybráno, odešle se organizátorům e-mailové oznámení o aktualizovaných "
"registracích."

msgid "Signup cancellation"
msgstr "Zrušení registrace"

msgid ""
"If selected, send organizers a notification email when a registration is "
"cancelled."
msgstr ""
"Pokud je vybráno, pošle organizátorům e-mailové upozornění při zrušení "
"registrace."

msgid "Payments received"
msgstr "Přijaté platby"

msgid "If selected, send organizers an email for each payment received."
msgstr "Je-li vybráno, organizátoři obdrží e-mail za každou přijatou platbu."

msgid "Customised mail server"
msgstr "Přizpůsobený poštovní server"

msgid "Pre-registration"
msgstr "Předběžná registrace"

msgid "Enable preferences"
msgstr "Povolení předvoleb"

msgid ""
"If enabled, participants give a preference value when adding pre-"
"registrations."
msgstr ""
"Je-li povoleno, účastníci při přidávání předregistrací zadají hodnotu "
"preference."

msgid "Easter egg"
msgstr "Easter egg"

msgid "Probability"
msgstr "Pravděpodobnost"

msgid "Probability of showing the special page (out of thousands)."
msgstr "Pravděpodobnost zobrazení speciální stránky (z tisíce)."

msgid "Badge"
msgstr "Badge"

msgid "Name of badge to be awarded."
msgstr "Název badge, který má být udělen."

msgid "Description to be shown on the special page."
msgstr "Popis, který se zobrazí na speciální stránce."

msgid "Page"
msgstr "Stránka"

msgid "Contents of the special page."
msgstr "Obsah speciální stránky."

msgid "Campaign"
msgstr "Kampaň"

msgid "Allow registration transfers"
msgstr "Povolit převody registrací"

msgid "Allow registration switching between events."
msgstr "Povolit přepínání registrace mezi akcemi."

msgid "Warehouse"
msgstr "Sklad"

msgid "Quantity"
msgstr "Množství"

msgid "If selected, add a field to track item quantities."
msgstr "Je-li vybráno, přidá se pole pro sledování množství položek."

msgid "Users"
msgstr "Uživatelé"

msgid "Event history"
msgstr "Historie událostí"

msgid ""
"If enabled, a user's public page shows a list of all events they have "
"attended."
msgstr ""
"Je-li povoleno, veřejná stránka uživatele zobrazí seznam všech akcí, kterých "
"se zúčastnil."

msgid "Deadline"
msgstr "Termín"

msgid "Tolerance"
msgstr "Tolerance"

msgid ""
"Number of days past the deadline beyond which registrations are marked to be "
"cancelled (default 30 days)."
msgstr ""
"Počet dní po termínu, po jejichž uplynutí jsou registrace označeny ke "
"zrušení (výchozí 30 dní)."

msgid "Frequency"
msgstr "Frekvence"

msgid ""
"Sets how often reminder emails are sent, in days (if not set, no emails are "
"sent)."
msgstr ""
"Nastavuje, jak často se odesílají připomínací e-maily, ve dnech (není-li "
"nastaveno, žádné e-maily se neodesílají)."

msgid "Voting"
msgstr "Hlasování"

msgid "Active"
msgstr "Aktivní"

msgid "If selected, members can vote."
msgstr "Je-li vybráno, členové mohou hlasovat."

msgid "Candidates"
msgstr "Kandidáti"

msgid "Candidates at the polls."
msgstr "Kandidáti ve volbách."

msgid "Minimum votes"
msgstr "Minimální počet hlasů"

msgid "Minimum number of votes."
msgstr "Minimální počet hlasů."

msgid "Maximum votes"
msgstr "Maximální počet hlasů"

msgid "Maximum number of votes."
msgstr "Maximální počet hlasů."

msgid "Reminder"
msgstr "Připomínka"

msgid "Sets how often reminder emails are sent, in days (default: 5)."
msgstr ""
"Nastavuje, jak často se odesílají připomínací e-maily, ve dnech (výchozí: 5)."

msgid "Public Holidays"
msgstr "Státní svátky"

msgid "If enabled, the system will send reminders on holidays."
msgstr "Je-li povoleno, systém bude odesílat připomínky i o svátcích."

msgid "Members"
msgstr "Členové"

msgid "Age"
msgstr "Věk"

msgid "Minimum age of members (leave empty for no limit)."
msgstr "Minimální věk členů (pro žádný limit nech prázdné)."

msgid "Annual fee"
msgstr "Roční poplatek"

msgid ""
"Annual fee required of members, starting from the beginning of the "
"membership year."
msgstr "Roční poplatek požadovaný od členů od začátku členského roku."

msgid "Start day"
msgstr "Počáteční den"

msgid "Day of the year from which the membership year begins, in DD-MM format."
msgstr "Den v roce, od kterého začíná členský rok, ve formátu DD-MM."

msgid "Enter a valid date in DD-MM format"
msgstr "Zadej platné datum ve formátu DD-MM"

msgid "Standalone Payment Window"
msgstr "Samostatné platební okno"

msgid ""
"Number of months at the start of the year during which members may pay the "
"annual fee without an active event registration."
msgstr ""
"Počet měsíců na začátku roku, během nichž je možné uhradit roční poplatek, "
"aniž by bylo nutné mít aktivní registraci na nějakou akci."

msgid "Charge transaction fees to participant"
msgstr "Účtuj transakční poplatky účastníkovi"

msgid ""
"If enabled, the system will automatically add payment gateway fees to the "
"ticket price, so the participant covers them instead of the organization."
msgstr ""
"Je-li povoleno, systém automaticky přidá poplatky platební brány k ceně "
"vstupenky, takže je místo organizace uhradí účastník."

msgid "Disable amount change"
msgstr "Zakázat změnu částky"

msgid ""
"If enabled, participants cannot change the payment amount for their "
"registrations."
msgstr ""
"Pokud je povoleno, účastníci nemohou změnit výši platby za své registrace."

msgid "Unique code"
msgstr "Jedinečný kód"

msgid "If enabled, adds a unique code to each payment to help identify it."
msgstr ""
"Pokud je povoleno, přidá ke každé platbě jedinečný kód, který pomůže s její "
"identifikací."

msgid "Require receipt for manual payments"
msgstr "Vyžadovat potvrzení o ručních platbách"

msgid ""
"If selected, participants must provide a receipt or invoice for manual "
"payments."
msgstr ""
"Pokud je vybráno, účastníci musí u ručních plateb poskytnout účtenku nebo "
"fakturu."

msgid "VAT"
msgstr "DPH"

msgid "Ticket"
msgstr "Vstupenka"

msgid "Percentage of VAT to be calculated on the ticket cost alone."
msgstr "Procento DPH, které se vypočítá pouze z ceny vstupenky."

msgid "Options"
msgstr "Možnosti"

msgid ""
"Percentage of VAT to be calculated on the sum of the costs of the "
"registration options."
msgstr ""
"Procento DPH, které se vypočítá ze součtu nákladů registračních možností."

msgid "Token name"
msgstr "Název tokenu"

msgid "Name to be displayed for tokens."
msgstr "Název zobrazovaný pro tokeny."

msgid "Credits name"
msgstr "Název kreditů"

msgid "Name to be displayed for credits."
msgstr "Jméno, které se má zobrazit v titulcích."

msgid "Lock events"
msgstr "Uzamknout události"

msgid ""
"If enabled, prevents credits from being created or changed in the event "
"panel."
msgstr "Je-li povoleno, zabrání vytváření nebo změně kreditů v panelu akce."

msgid "Treasury"
msgstr "Pokladna"

msgid "Appointees"
msgstr "Jmenovaní"

msgid "Treasury appointees."
msgstr "Pověřenci pokladny."

msgid "Organizational fee"
msgstr "Organizační poplatek"

msgid "Percentage"
msgstr "Procento"

msgid ""
"Percentage of takings calculated as a fee for association infrastructure (in "
"whole numbers from 0 to 100)."
msgstr ""
"Procento příjmů vypočítané jako poplatek za infrastrukturu spolku (v celých "
"číslech od 0 do 100)."

msgid "Disable event-level approval"
msgstr "Zakaž schvalování na úrovni událostí"

msgid ""
"When enabled, expense approvals can only be managed from the organization "
"dashboard."
msgstr ""
"Je-li povoleno, schvalování výdajů lze spravovat pouze z nástěnky organizace."

msgid "Promotion"
msgstr "Propagace"

msgid "Publish staff"
msgstr "Zveřejnit organizační tým"

msgid "If selected, publish staff members."
msgstr "Je-li vybráno, zveřejnit členy týmu."

msgid "Publish players"
msgstr "Zveřejnit hráče"

msgid "If selected, publish registered players."
msgstr "Je-li vybráno, zveřejnit registrované hráče."

msgid "Authentication token (mark all permissions)."
msgstr "Ověřovací token (označ všechna oprávnění)."

msgid "Your team ID."
msgstr "ID tvého týmu."

msgid "App Integration"
msgstr "Integrace aplikací"

msgid "Button text"
msgstr "Text tlačítka"

msgid "Label shown on the topbar button to access the external application."
msgstr ""
"Popisek zobrazený na tlačítku v horní liště pro přístup k externí aplikaci."

msgid "Redirect URL"
msgstr "Adresa URL přesměrování"

msgid "URL of the external application where the user will be redirected."
msgstr "URL externí aplikace, kam bude uživatel přesměrován."

msgid "Shared secret"
msgstr "Sdílené tajemství"

msgid ""
"Secret key used to sign the JWT token for SSO authentication with the "
"external application."
msgstr ""
"Tajný klíč použitý k podepsání tokenu JWT pro SSO ověření s externí aplikací."

msgid "Algorithm"
msgstr "Algoritmus"

msgid "Signing algorithm for the JWT token (default: HS256)."
msgstr "Podpisový algoritmus pro token JWT (výchozí: HS256)."

msgid "Receipts"
msgstr "Příjmové doklady"

msgid "Full name"
msgstr "Celé jméno"

msgid "Name as will appear on the receipt header."
msgstr "Název, jak se zobrazí v záhlaví účtenky."

msgid "Legal address"
msgstr "Právní adresa"

msgid "Full address of the association."
msgstr "Úplná adresa spolku."

msgid "Fiscal code"
msgstr "Daňové identifikační číslo"

msgid "Tax identification code of the association."
msgstr "Daňové identifikační číslo spolku."

msgid "RUNTS registration"
msgstr "Registrace RUNTS"

msgid "Registration info"
msgstr "Informace o registraci"

msgid "Electronic invoice"
msgstr "Elektronická faktura"

msgid "Municipality"
msgstr "Obec"

msgid "Province"
msgstr "Provincie"

msgid "Nation"
msgstr "Národ"

msgid "Quick Setup"
msgstr "Rychlé nastavení"

msgid ""
"Select which common features to activate for your organization to get "
"started quickly"
msgstr ""
"Vyber, které běžné funkce chceš ve své organizaci aktivovat, abys mohl/a "
"rychle začít"

msgid ""
"Do you want to manage campaigns, a series of events that share the same "
"characters?"
msgstr ""
"Chceš spravovat kampaně, tedy série akcí, které sdílejí stejné postavy?"

msgid ""
"Do you want to make your upcoming events visible to external sites through a "
"public API?"
msgstr ""
"Chceš své nadcházející akce zpřístupnit externím webům prostřednictvím "
"veřejného API?"

msgid "Do you want to accept payments processed through the system?"
msgstr "Chceš přijímat platby zpracované systémem?"

msgid "Transaction fees"
msgstr "Transakční poplatky"

msgid ""
"Do you want to add payment gateway fees to the ticket price so the user pays "
"them instead of the organization?"
msgstr ""
"Chceš k ceně vstupenky přidat poplatky platební brány, aby je platil "
"uživatel místo organizace?"

msgid "Membership"
msgstr "Členství"

msgid "Do you want users to join events only after an approval process?"
msgstr ""
"Chceš, aby se uživatelé mohli připojit k akcím až po schvalovacím procesu?"

msgid "Deadlines"
msgstr "Termíny"

msgid ""
"Do you want a dashboard to track and manage deadlines missed by registered "
"users?"
msgstr ""
"Chceš nástěnku pro sledování a správu termínů zmeškaných registrovanými "
"uživateli?"

msgid "Reminders"
msgstr "Připomínky"

msgid ""
"Do you want to enable automatic email reminders for registered users who "
"miss a deadline?"
msgstr ""
"Chceš zapnout automatické e-mailové připomínky pro registrované uživatele, "
"kteří zmeškají termín?"

msgid "Help"
msgstr "Nápověda"

msgid "Do you want to manage user help requests directly through the platform?"
msgstr "Chceš spravovat žádosti uživatelů o pomoc přímo přes platformu?"

msgid "Do you want to allow users to make voluntary donations?"
msgstr "Chceš uživatelům umožnit dobrovolné dary?"

msgid "Personal preferences"
msgstr "Osobní preference"

msgid ""
"Set your personal theme, notification digest mode, and interface version; "
"these settings override the organization defaults for your account only"
msgstr ""
"Nastav si vlastní motiv, režim souhrnu oznámení a verzi uživatelského "
"rozhraní; tato nastavení mají přednost před výchozími nastaveními "
"organizace, a to pouze pro tvůj účet."

msgid "Personal theme preference, overrides the event and organization theme."
msgstr "Osobní preference motivu, přepíše motiv akce a organizace."

msgid "Interface version"
msgstr "Verze rozhraní"

msgid ""
"Personal interface version preference, overrides the organization setting"
msgstr ""
"Osobní předvolba verze rozhraní, má přednost před nastavením organizace"

msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Vyber platnou volbu. Tato volba není jednou z dostupných možností."

msgid "Selected event does not belong to this organization"
msgstr "Vybraná událost nepatří do této organizace"

#, python-format
msgid "%(field)s already used"
msgstr "%(field)s již bylo použito"

msgid "You have exceeded the maximum number of selectable options"
msgstr "Překročil(a) jsi maximální počet volitelných možností"

msgid "You have exceeded the maximum text length"
msgstr "Překročil/a jsi maximální délku textu"

msgid "Option no longer available"
msgstr "Možnost již není k dispozici"

msgid "Invalid ticket selection"
msgstr "Neplatný výběr lístku"

msgid "Read only"
msgstr "Pouze pro čtení"

msgid "Not selected"
msgstr "Nevybráno"

msgid "Choose one option"
msgstr "Vyber jednu možnost"

msgid "Select one or more options"
msgstr "Vyber jednu nebo více možností"

msgid ""
"<b>Nebula</b>: mixed dark and light theme (default). <b>Aurora</b>: full "
"light theme. <b>Eclipse</b>: full dark theme. <b>Halo</b>: custom (enables "
"custom CSS, colors, and background).<b>---</b>: will use default values. "
msgstr ""
"<b>Nebula</b>: smíšené tmavé a světlé téma (výchozí). <b>Aurora</b>: plně "
"světlé téma. <b>Eclipse</b>: plně tmavé téma. <b>Halo</b>: vlastní (umožňuje "
"vlastní CSS, barvy a pozadí). <b>---</b>: použije výchozí hodnoty"

msgid "Character"
msgstr "Postava"

msgid "Factions"
msgstr "Frakce"

msgid "Show available factions"
msgstr "Zobrazit dostupné frakce"

msgid "Select only one primary faction"
msgstr "Vyber pouze jednu primární frakci"

#, python-format
msgid "The option '%(option)s' requires: %(missing)s"
msgstr "Volba '%(option)s' vyžaduje: %(missing)s"

msgid "Manage characters of the event"
msgstr "Spravuj postavy v rámci akce"

msgid "Characters"
msgstr "Postavy"

msgid "--- NOT ASSIGNED ---"
msgstr "--- NEPŘIDĚLENO ---"

msgid "Inactive characters can't be assigned to players"
msgstr "Neaktivní postavy nelze přiřadit k hráčům"

#, python-format
msgid "This text will be added to the %(name)s plot paragraph in the sheet."
msgstr "Tento text bude přidán do odstavce zápletky %(name)s v kartě."

msgid "Abilities"
msgstr "Schopnosti"

msgid "Award"
msgstr "Udělení"

msgid "Manage the questions displayed in the character writing form"
msgstr "Správa otázek zobrazených ve formuláři pro vytváření postavy"

msgid "Sheet"
msgstr "List"

msgid "Manage the selectable options for a character form question"
msgstr "Správa volitelných možností pro otázku ve formuláři postavy"

msgid "Writing options"
msgstr "Možnosti psaní"

msgid "The CSS code to customize PDF printing."
msgstr "CSS kód pro přizpůsobení tisku PDF."

msgid "Header HTML"
msgstr "Záhlaví HTML"

msgid "The HTML code for the header."
msgstr "HTML kód pro záhlaví."

msgid "Footer HTML"
msgstr "Zápatí HTML"

msgid "The HTML code for the footer."
msgstr "HTML kód pro zápatí."

msgid "Event"
msgstr "Událost"

msgid "Edit the basic settings of this event"
msgstr "Uprav základní nastavení této události"

msgid "Event features"
msgstr "Funkce události"

msgid ""
"Enable or disable features for this event and all its runs; click a feature "
"name to read its description"
msgstr ""
"Zapni nebo vypni funkce pro tuto událost a všechna její provedení; kliknutím "
"na název funkce si můžeš přečíst její popis"

msgid "Event Configuration"
msgstr "Konfigurace události"

msgid ""
"View and adjust configuration options for each feature activated on this "
"event"
msgstr ""
"Zobraz si a uprav možnosti nastavení pro každou funkci aktivovanou v rámci "
"této události"

msgid "Display"
msgstr "Zobrazit"

msgid "Show shortcuts"
msgstr "Zobrazit zkratky"

msgid "If enabled, automatically show shortcuts on mobile."
msgstr "Je-li povoleno, automaticky zobrazovat zkratky na mobilu."

msgid "Export"
msgstr "Export"

msgid ""
"If enabled, allows characters and registrations to be exported to an easily "
"readable page."
msgstr ""
"Pokud je povoleno, umožňuje exportovat postavy a registrace na snadno "
"čitelnou stránku."

msgid "Collapse options minimum"
msgstr "Minimální počet možností ke sbalení"

msgid ""
"Indicate the minimum number of options a form field must have to hide the "
"unselected ones behind the 'Show other options' link; if empty, the default "
"of 5 is used."
msgstr ""
"Určete minimální počet možností, které musí mít pole formuláře, aby se "
"nevybrané skryly za odkazem „Zobrazit další možnosti“; pokud pole necháte "
"prázdné, použije se výchozí hodnota 5."

msgid "Show availability"
msgstr "Zobrazit dostupnost"

msgid ""
"If enabled, show players a page with the remaining spots for tickets, "
"options and discounts that have a limited number."
msgstr ""
"Pokud je povoleno, zobraz hráčům stránku se zbývajícími místy pro vstupenky, "
"možnosti a slevy s omezeným počtem."

msgid "Character cover"
msgstr "Obal postavy"

msgid "Use full-size image"
msgstr "Použít obrázek v plné velikosti"

msgid ""
"If enabled, displays the original full-sized image instead of the thumbnail "
"version."
msgstr ""
"Je-li povoleno, zobrazí původní obrázek v plné velikosti místo verze náhledu."

msgid "Disable assignment"
msgstr "Zakázat přiřazení"

msgid ""
"If enabled, does not send a notification to the participant when a character "
"is assigned."
msgstr ""
"Pokud je povoleno, neodešle účastníkovi oznámení při přiřazení postavy."

msgid "Ensemble"
msgstr "Ensemble"

msgid "Show player name"
msgstr "Zobrazit jméno hráče"

msgid "If enabled, shows the player's name alongside their character."
msgstr "Je-li povoleno, zobrazí jméno hráče vedle jeho postavy."

msgid "Default view mode"
msgstr "Výchozí režim zobrazení"

msgid "The initial display mode when opening the ensemble page."
msgstr "Výchozí režim zobrazení při otevření stránky Ensemble."

msgid "Book"
msgstr "Kniha"

msgid "Cards"
msgstr "Karty"

msgid "Compact list"
msgstr "Kompaktní seznam"

msgid "Tickets"
msgstr "Vstupenky"

msgid "If enabled, allow ticket tier: Staff."
msgstr "Je-li povoleno, umožnit úroveň vstupenky: Staff."

msgid "If enabled, allow ticket tier: NPC."
msgstr "Je-li povoleno, umožnit úroveň vstupenky: NPC."

msgid "If enabled, allow ticket tier: Collaborator."
msgstr "Je-li povoleno, umožnit úroveň vstupenky: Spolupracovník."

msgid "If enabled, allow ticket tier: Seller."
msgstr "Je-li povoleno, umožnit úroveň vstupenky: Prodejce."

msgid "Show sold tickets"
msgstr "Zobrazit prodané vstupenky"

msgid ""
"If enabled, show on the event page the total number of tickets sold, plus "
"the number sold for each enabled ticket."
msgstr ""
"Pokud je povoleno, na stránce akce se zobrazí celkový počet prodaných "
"vstupenek a také počet prodaných vstupenek pro každý povolený typ."

msgid "Patron / Reduced"
msgstr "Mecenáš / Snížené"

msgid ""
"The ratio between reduced and patron tickets, multiplied by 10. Example: 10 "
"-> 1 reduced ticket for 1 patron ticket. 20 -> 2 reduced tickets for 1 "
"patron ticket. 5 -> 1 reduced ticket for 2 patron tickets"
msgstr ""
"Poměr mezi zlevněnými a patronátními vstupenkami vynásobený 10. Příklad: 10 "
"-> 1 zlevněná vstupenka na 1 patronátní vstupenku. 20 -> 2 zlevněné "
"vstupenky na 1 patronátní vstupenku. 5 -> 1 zlevněná vstupenka na 2 "
"patronátní vstupenky"

msgid "Allow reserve signup anytime"
msgstr "Umožni registraci do rezervy kdykoli"

msgid ""
"If enabled, participants can sign up for the reserve list at any time. If "
"disabled, reserve signups open only after the event capacity is reached."
msgstr ""
"Je-li tato funkce zapnutá, mohou se účastníci kdykoli zapsat na čekací "
"listinu. Je-li vypnutá, registrace na čekací listinu se otevře až po "
"naplnění kapacity akce."

msgid "Number of extractions"
msgstr "Počet extrakcí"

msgid "Number of tickets to be drawn."
msgstr "Počet losovaných vstupenek."

msgid "Conversion ticket"
msgstr "Konverzní lístek"

msgid "Name of the ticket into which to convert."
msgstr "Název vstupenky, na kterou převést."

msgid "Gallery"
msgstr "Galerie"

msgid "Require login"
msgstr "Vyžadovat přihlášení"

msgid ""
"If enabled, the characters will not be displayed to those not logged in to "
"the system."
msgstr "Je-li povoleno, postavy se nezobrazí nepřihlášeným uživatelům."

msgid "Require registration"
msgstr "Vyžadovat registraci"

msgid ""
"If enabled, the characters will not be displayed to those who are not "
"registered to the event."
msgstr ""
"Je-li povoleno, postavy se nezobrazí těm, kdo nejsou registrováni na akci."

msgid "Hide unassigned characters"
msgstr "Skryj nepřiřazené postavy"

msgid ""
"If enabled, does not show characters in the gallery who have not been "
"assigned a participant."
msgstr ""
"Je-li povoleno, v galerii se nezobrazí postavy, kterým nebyl přiřazen "
"účastník."

msgid "Hide participants without a character"
msgstr "Skrýt účastníky bez postavy"

msgid ""
"If enabled, does not show participants in the gallery who have not been "
"assigned a character."
msgstr ""
"Je-li povoleno, v galerii se nezobrazí účastníci, kterým nebyla přiřazena "
"postava."

msgid "Disable grouping"
msgstr "Zakázat seskupování"

msgid ""
"If enabled, all registrations are displayed in a single table rather than "
"being separated by type."
msgstr ""
"Je-li povoleno, všechny registrace se zobrazí v jedné tabulce místo "
"rozdělení podle typu."

msgid "Allowed"
msgstr "Povolené"

msgid ""
"If enabled, lets you set which staff members may see participants' answers "
"to each registration question."
msgstr ""
"Pokud je povoleno, můžeš nastavit, kteří členové týmu mohou vidět odpovědi "
"účastníků na jednotlivé registrační otázky."

msgid "Hide not available"
msgstr "Skrýt nedostupné"

msgid ""
"If enabled, options no longer available in the registration form are hidden, "
"instead of being displayed disabled."
msgstr ""
"Je-li povoleno, možnosti, které už nejsou v registračním formuláři dostupné, "
"se skryjí místo zobrazení jako zakázané."

msgid "Faction selection"
msgstr "Výběr frakce"

msgid ""
"If enabled, allows a registration form question to be visible only if the "
"participant is assigned to certain factions."
msgstr ""
"Pokud je povoleno, umožňuje zobrazit otázku registračního formuláře jen "
"tehdy, když je účastník přiřazen k určitým frakcím."

msgid "Ticket selection"
msgstr "Výběr vstupenek"

msgid ""
"If enabled, allows a registration form question to be visible based on the "
"selected registration ticket."
msgstr ""
"Pokud je povoleno, umožňuje zobrazit otázku registračního formuláře podle "
"vybrané registrační vstupenky."

msgid "Age selection"
msgstr "Výběr věku"

msgid ""
"If enabled, allows a registration form question to be visible based on the "
"participant's age."
msgstr ""
"Je-li povoleno, otázka v registračním formuláři může být viditelná podle "
"věku účastníka."

msgid "Disable cancellation"
msgstr "Zakázat zrušení"

msgid ""
"If enabled, participants cannot cancel their own registration; A "
"cancellation request email will be sent to the staff instead."
msgstr ""
"Je-li povoleno, účastníci nemohou zrušit vlastní registraci; místo toho se "
"týmu odešle e-mail se žádostí o zrušení."

msgid "Approval process"
msgstr "Schvalovací proces"

msgid ""
"If enabled, players cannot sign up directly; they submit a signup request "
"that an organizer must approve before they can complete registration."
msgstr ""
"Je-li povoleno, hráči se nemohou registrovat přímo; odešlou žádost o "
"registraci, kterou musí organizátor schválit, než budou moci registraci "
"dokončit."

msgid "Character Sheet"
msgstr "List postavy"

msgid ""
"If enabled, options no longer available in the form are hidden, instead of "
"being displayed disabled."
msgstr ""
"Je-li povoleno, možnosti, které už nejsou ve formuláři dostupné, se skryjí "
"místo zobrazení jako zakázané."

msgid "Maximum available"
msgstr "Maximální dostupný počet"

msgid "If enabled, an option can be chosen a maximum number of times."
msgstr "Je-li povoleno, možnost lze vybrat maximálně stanovený početkrát."

msgid ""
"If enabled, allows an option to be visible only to participants with a "
"selected ticket."
msgstr ""
"Pokud je povoleno, umožňuje zobrazit možnost pouze účastníkům s vybranou "
"vstupenkou."

msgid "Requirements"
msgstr "Požadavky"

msgid ""
"If enabled, allows an option to be visible only if other options are "
"selected."
msgstr ""
"Pokud je povoleno, umožňuje zobrazit možnost pouze v případě, že jsou "
"vybrány jiné možnosti."

msgid "Title"
msgstr "Název"

msgid ""
"Enables field 'title', a short (2-3 words) text added to the character's "
"name."
msgstr "Povolí pole „titul“, krátký text (2–3 slova) přidaný ke jménu postavy."

msgid "Number"
msgstr "Číslo"

msgid ""
"Enables the 'number' field, a unique numerical ID used to reference the "
"character."
msgstr ""
"Aktivuje pole „číslo“, jedinečné číselné ID používané pro odkazování na "
"postavu."

msgid "Cover image"
msgstr "Obrázek na obálce"

msgid ""
"Enables the 'cover' field to show a specific image in the gallery until the "
"character is assigned to a participant."
msgstr ""
"Aktivuje pole „obálka“, které zobrazuje konkrétní obrázek v galerii, dokud "
"není postava přiřazena účastníkovi."

msgid "Hide"
msgstr "Skrýt"

msgid ""
"Enables the 'hide' field, which hides a writing element from participants."
msgstr "Povolí pole „skrýt“, které skryje prvek textu před účastníky."

msgid "Locked"
msgstr "Uzamčeno"

msgid ""
"Enables the 'locked' field, which prevents players from viewing the full "
"character sheet even when it is assigned."
msgstr ""
"Povolí pole „uzamčeno“, které hráčům brání zobrazit úplný list postavy, i "
"když je jim přiřazena."

msgid ""
"Enables the 'assigned' field, which tracks the staff member responsible for "
"each writing element."
msgstr ""
"Povolí pole „přiřazeno“, které sleduje člena týmu odpovědného za každý prvek "
"textu."

msgid "Field visibility"
msgstr "Viditelnost polí"

msgid ""
"Normally all character fields (public or private) are shown; with this "
"configuration you can select which ones to display at any given time."
msgstr ""
"Normálně se zobrazují všechna pole postavy (veřejná i soukromá); s touto "
"konfigurací můžeš vybrat, která se mají kdy zobrazit."

msgid "Played characters"
msgstr "Hrané postavy"

msgid "Number of characters each participant plays in the event (default=1)."
msgstr "Počet postav, které každý účastník hraje na akci (výchozí=1)."

msgid "Disable character finder"
msgstr "Zakázat vyhledávač postav"

msgid ""
"Disable the system that finds the character number when a special reference "
"symbol is written:"
msgstr ""
"Vypnout systém, který vyhledá číslo postavy při napsání speciálního "
"referenčního symbolu:"

msgid "Replacing names"
msgstr "Nahrazování jmen"

msgid ""
"If enabled, character names will be automatically replaced by a reference."
msgstr "Je-li povoleno, jména postav budou automaticky nahrazena odkazem."

msgid "Paste as text"
msgstr "Vložit jako text"

msgid ""
"If enabled, automatically removes formatting when pasting text into the "
"WYSIWYG editor."
msgstr ""
"Je-li povoleno, automaticky při vkládání textu do WYSIWYG editoru odstraní "
"formátování."

msgid "Disable Auto save"
msgstr "Zakázat automatické ukládání"

msgid ""
"If enabled, automatic saving while editing writing elements will be disabled."
msgstr ""
"Pokud je povoleno, automatické ukládání při úpravě textových prvků bude "
"vypnuto."

msgid "External access"
msgstr "Externí přístup"

msgid ""
"If enabled, generates secret URLs for sharing the full character sheet with "
"a user who has not signed up."
msgstr ""
"Pokud je povoleno, vytvoří tajné URL pro sdílení kompletního listu postavy s "
"uživatelem, který se nezaregistroval."

msgid "Unimportant"
msgstr "Nedůležité"

msgid ""
"If enabled, allows tracking plots or relationships that are less important "
"to the character."
msgstr ""
"Pokud je povoleno, umožňuje sledovat zápletky nebo vztahy, které jsou pro "
"postavu méně důležité."

msgid "Check"
msgstr "Zkontrolovat"

msgid "If enabled, enables the consistency check tool for character sheets."
msgstr ""
"Je-li povoleno, aktivuje nástroj kontroly konzistence pro listy postav."

msgid "Reading"
msgstr "Čtení"

msgid "If enabled, enables the reading view for writing elements."
msgstr "Je-li povoleno, aktivuje zobrazení pro čtení prvků při psaní."

msgid "Relationships"
msgstr "Vztahy"

msgid "Relationships max length"
msgstr "Maximální délka vztahů"

msgid ""
"Set the maximum length of character relationships (default: 10,000 "
"characters)."
msgstr "Nastav maximální délku vztahů postavy (výchozí: 10 000 znaků)."

msgid "Disable auto relationships"
msgstr "Zakaž automatické vztahy"

msgid ""
"If enabled, auto-relationships from character references will not be created."
msgstr ""
"Je-li povoleno, automatické vztahy z odkazů na postavy nebudou vytvářeny."

msgid "Relationship tags"
msgstr "Štítky vztahů"

msgid ""
"If enabled, lets you define reusable tags (e.g. love, rivalry) to apply to "
"character relationships, applied to both sides of the relationship when the "
"tag is symmetric."
msgstr ""
"Pokud je povoleno, umožní ti definovat znovupoužitelné štítky (např. láska, "
"rivalita), které lze přidávat ke vztahům postav; pokud je štítek symetrický, "
"použije se na obě strany vztahu."

msgid "Split by participation"
msgstr "Rozdělení podle účasti"

msgid ""
"If enabled, show two separate tables on the characters page, one for "
"characters participating in this run and one for non-participating "
"characters."
msgstr ""
"Je-li povoleno, na stránce postav zobrazit dvě samostatné tabulky: jednu pro "
"postavy účastnící se tohoto běhu a druhou pro neúčastnící se postavy."

msgid "Independent factions"
msgstr "Nezávislé frakce"

msgid "If enabled, do not use the parent event's factions."
msgstr "Je-li povoleno, nepoužívat frakce nadřazené akce."

msgid "Experience points"
msgstr "Zkušenostní body"

msgid "Player selection"
msgstr "Výběr hráče"

msgid ""
"If enabled, participants may add abilities themselves, by selecting from "
"those that are visible, and whose pre-requisites they meet."
msgstr ""
"Pokud je povoleno, účastníci si mohou sami přidávat schopnosti výběrem z "
"těch, které jsou viditelné a pro něž splňují předpoklady."

msgid "Undo period"
msgstr "Lhůta pro zrušení"

msgid ""
"Time window (in hours) during which the user can revoke a chosen ability and "
"recover spent XP (default is 0)."
msgstr ""
"Časové okno (v hodinách), během kterého může uživatel zrušit vybranou "
"schopnost a získat zpět utracené XP (výchozí hodnota je 0)."

msgid "Initial experience points"
msgstr "Počáteční zkušenostní body"

msgid "Initial value of experience points for all characters."
msgstr "Počáteční hodnota zkušenostních bodů pro všechny postavy."

msgid "Ability templates"
msgstr "Šablony schopností"

msgid ""
"If enabled, enables ability templates that can be reused across multiple "
"abilities."
msgstr ""
"Je-li povoleno, aktivuje šablony schopností, které lze znovu použít pro více "
"schopností."

msgid "Rules"
msgstr "Pravidla"

msgid ""
"If enabled, enables rules for computed character fields based on abilities."
msgstr ""
"Je-li povoleno, aktivuje pravidla pro vypočítaná pole postav založená na "
"schopnostech."

msgid "Modifiers"
msgstr "Modifikátory"

msgid ""
"If enabled, enables modifiers that can adjust ability costs based on "
"prerequisites and requirements."
msgstr ""
"Je-li povoleno, aktivuje modifikátory, které mohou upravovat náklady "
"schopností podle předpokladů a požadavků."

msgid "Criteria"
msgstr "Kritéria"

msgid ""
"If enabled, this feature enables criteria that conditionally modify "
"experience point totals based on prerequisites and requirements."
msgstr ""
"Je-li povoleno, tato funkce aktivuje kritéria, která podmíněně upravují "
"celkové zkušenostní body podle předpokladů a požadavků."

msgid "Auto buy"
msgstr "Automatický nákup"

msgid ""
"If enabled, characters automatically and repeatedly acquire the most "
"expensive available ability with their remaining XP, until no more can be "
"bought."
msgstr ""
"Pokud je povoleno, postavy automaticky a opakovaně získávají nejdražší "
"dostupnou schopnost za zbývající XP, dokud už nelze koupit žádnou další."

msgid "Disable free abilities"
msgstr "Vypnout bezplatné schopnosti"

msgid ""
"If enabled, characters no longer automatically acquire abilities with a cost "
"of zero."
msgstr ""
"Pokud je povoleno, postavy již automaticky nezískávají schopnosti s nulovou "
"cenou."

msgid "Multiple systems"
msgstr "Více systémů"

msgid ""
"If enabled, enables managing multiple experience systems for the event. Each "
"ability and award can be assigned to a specific system."
msgstr ""
"Pokud je povoleno, zapne správu více systémů zkušeností pro akci. Každé "
"schopnosti a každému přidělení lze přiřadit konkrétní systém."

msgid "Character creation"
msgstr "Vytvoření postavy"

msgid "Maximum number"
msgstr "Maximální počet"

msgid "Maximum number of characters the player can create (default=1)."
msgstr "Maximální počet postav, které může hráč vytvořit (výchozí=1)."

msgid "Approval"
msgstr "Schválení"

msgid "If enabled, activates a staff-managed approval process for characters."
msgstr "Je-li povoleno, aktivuje proces schvalování postav spravovaný týmem."

msgid ""
"If enabled, the character form of the players will not be saved "
"automatically while editing."
msgstr ""
"Je-li povoleno, formulář postavy hráčů se při úpravách nebude ukládat "
"automaticky."

msgid "Guilds"
msgstr "Cechy"

msgid "Maximum number of guilds players can create (0 = no limit)."
msgstr "Maximální počet gild, které mohou hráči vytvořit (0 = bez limitu)."

msgid "Maximum members"
msgstr "Maximální počet členů"

msgid "Maximum number of accepted members per guild (0 = no limit)."
msgstr "Maximální počet přijatých členů na gildu (0 = bez limitu)."

msgid "Character customisation"
msgstr "Přizpůsobení postavy"

msgid "Name"
msgstr "Jméno"

msgid ""
"If enabled, allows participants to customise the names of their characters."
msgstr "Pokud je povoleno, účastníci si mohou upravit jména svých postav."

msgid "Profile"
msgstr "Profil"

msgid ""
"If enabled, allows participants to customise their characters' profile "
"picture."
msgstr ""
"Je-li povoleno, umožní účastníkům přizpůsobit profilový obrázek jejich "
"postav."

msgid "Pronoun"
msgstr "Zájmeno"

msgid ""
"If enabled, allows participants to customise their characters' pronouns."
msgstr "Pokud je povoleno, účastníci si mohou upravit zájmena svých postav."

msgid "Song"
msgstr "Píseň"

msgid ""
"If enabled allows participants to indicate the song of their characters."
msgstr "Pokud je povoleno, účastníci mohou uvést píseň svých postav."

msgid "Private"
msgstr "Soukromé"

msgid ""
"If enabled allows participants to enter private information on their "
"characters, visible only to them and the staff."
msgstr ""
"Pokud je povoleno, účastníci mohou u svých postav zadat soukromé informace, "
"které uvidí pouze oni a organizační tým."

msgid "Public"
msgstr "Veřejné"

msgid ""
"If enabled allows participants to enter public information on their "
"characters, visible to all."
msgstr ""
"Pokud je povoleno, účastníci mohou u svých postav zadat veřejné informace, "
"které uvidí všichni."

msgid "Casting"
msgstr "Casting"

msgid "Minimum preferences"
msgstr "Minimální preference"

msgid "Minimum number of preferences."
msgstr "Minimální počet preferencí."

msgid "Maximum preferences"
msgstr "Maximální preference"

msgid "Maximum number of preferences."
msgstr "Maximální počet preferencí."

msgid "Additional Preferences"
msgstr "Další předvolby"

msgid ""
"Additional preferences, for random assignment when no solution is found "
"(default 0)."
msgstr ""
"Dodatečné preference pro náhodné přiřazení, když se nenajde řešení (výchozí "
"0)."

msgid "Field for exclusions"
msgstr "Pole pro vyloučení"

msgid ""
"If enabled, it adds a field in which the participant can indicate which "
"elements they wish to avoid altogether."
msgstr ""
"Je-li povoleno, přidá pole, ve kterém může účastník uvést prvky, kterým se "
"chce zcela vyhnout."

msgid "Assignments"
msgstr "Přiřazení"

msgid "Number of characters to be assigned (default 1)."
msgstr "Počet postav k přiřazení (výchozí 1)."

msgid "Mirror"
msgstr "Zrcadlo"

msgid ""
"Allows you to set a character as a 'mirror' of another character to hide its "
"true nature."
msgstr ""
"Umožňuje nastavit postavu jako „zrcadlo“ jiné postavy, aby se skryla její "
"skutečná povaha."

msgid "Show statistics"
msgstr "Zobrazit statistiky"

msgid ""
"If enabled, participants will be able to view for each character the "
"preference statistics."
msgstr ""
"Je-li povoleno, účastníci budou moci u každé postavy zobrazit statistiky "
"preferencí."

msgid "Show history"
msgstr "Zobrazit historii"

msgid "If enabled, shows participants the histories of preferences entered."
msgstr "Je-li povoleno, zobrazí účastníkům historii zadaných preferencí."

msgid "Registration priority"
msgstr "Přednostní registrace"

msgid ""
"A measure of how much to favor earlier registrants (0=default disabled, "
"1=normal, 10=strong)."
msgstr ""
"Míra zvýhodnění dříve registrovaných (0=výchozí vypnuto, 1=normální, "
"10=silné)."

msgid "Payment priority"
msgstr "Priorita platby"

msgid ""
"A measure of how much to favor participants who completed full payment "
"earlier (0=default disabled, 1=normal, 10=strong)."
msgstr ""
"Míra zvýhodnění účastníků, kteří dříve dokončili úplnou platbu (0=výchozí "
"vypnuto, 1=normální, 10=silné)."

msgid "Payment reminder"
msgstr "Upomínka k platbě"

msgid ""
"Given a payment deadline, indicates the number of days under which it "
"notifies the participant to proceed with the payment. Default 30."
msgstr ""
"Vzhledem k termínu platby uvede počet dní, do kterých oznámí účastníkovi, "
"aby platbu provedl. Výchozí hodnota 30."

msgid "Payment reference"
msgstr "Referenční číslo platby"

msgid ""
"If present, it indicates the reason for the payment that the participant "
"must put on the payments they make."
msgstr ""
"Pokud je přítomen, označuje důvod platby, který musí účastník uvést na "
"platbách, které provádí."

msgid "You can use the following fields; they will be filled in automatically:"
msgstr "Můžeš použít následující pole; budou vyplněna automaticky:"

msgid "Disable provisional registrations"
msgstr "Zakázat prozatímní registrace"

msgid ""
"If enabled, all registrations are confirmed even if no payment has been "
"received."
msgstr ""
"Je-li povoleno, všechny registrace jsou potvrzeny, i když nebyla přijata "
"žádná platba."

msgid "Disable Tokens"
msgstr "Zakázat tokeny"

msgid "If enabled, no tokens will be used in the entries of this event."
msgstr "Je-li povoleno, v registracích této akce se nebudou používat tokeny."

msgid "Disable credits"
msgstr "Zakázat kredity"

msgid "If enabled, no credits will be used in the entries for this event."
msgstr "Je-li povoleno, v registracích této akce se nebudou používat kredity."

msgid "Bring a friend"
msgstr "Přiveď kamaráda"

msgid "Referrer Reward Discount"
msgstr "Sleva pro doporučitele"

msgid ""
"Discount awarded to an existing participant when a friend signs up using "
"their code."
msgstr ""
"Sleva udělená stávajícímu účastníkovi, když se kamarád zaregistruje pomocí "
"jeho kódu."

msgid "Referred Friend Discount"
msgstr "Sleva pro doporučeného přítele"

msgid "Discount amount applied to a new user signing up with a referral code."
msgstr ""
"Výše slevy uplatněná na nového uživatele, který se registruje s "
"doporučovacím kódem."

msgid "Event Appearance"
msgstr "Vzhled akce"

msgid "Customize the visual appearance of the event"
msgstr "Přizpůsob vzhled události"

msgid ""
"These CSS commands will be carried over to all pages in your Association "
"space"
msgstr "Tyto příkazy CSS se přenesou na všechny stránky v prostoru Asociace"

msgid "Event Texts"
msgstr "Texty událostí"

msgid "Manage custom text entries used across different sections of this event"
msgstr ""
"Správa vlastních textových záznamů používaných v různých částech této akce"

msgid "Text shown at the start of all character sheets"
msgstr "Text zobrazený na začátku všech listů postav"

msgid "Added to the registration page, before the form"
msgstr "Přidáno na registrační stránku před formulář"

msgid "Added at the top of the search page of characters"
msgstr "Přidáno v horní části stránky vyhledávání postav"

msgid "Added at the bottom of mail confirming signup to participants"
msgstr "Přidáno na konec e-mailu potvrzujícího účastníkům přihlášení"

msgid ""
"Added at the bottom of mail notifying participants of character assignment"
msgstr "Přidáno v dolní části mailu s oznámením o přidělení postavy"

msgid ""
"Content of mail notifying participants of their character in proposed status"
msgstr ""
"Obsah e-mailu, kterým se účastníkům oznamuje jejich postava v navrhovaném "
"statusu"

msgid ""
"Content of mail notifying participants of their character in approved status"
msgstr ""
"Obsah e-mailu oznamujícího účastníkům jejich postavu ve schváleném statusu"

msgid ""
"Content of mail notifying participants of their character in review status"
msgstr ""
"Obsah e-mailu oznamujícího účastníkům jejich postavu ve stavu přezkoumání"

msgid ""
"Shown on the signup request page and added to the request-received "
"confirmation mail"
msgstr ""
"Zobrazuje se na stránce žádosti o registraci a je uvedeno v potvrzovacím e-"
"mailu o přijetí žádosti"

msgid ""
"Manage organizer roles and assign permissions to staff members for this event"
msgstr "Spravuj role organizátorů a přiřaď členům týmu oprávnění pro tuto akci"

msgid ""
"If you don't find a user, save the role and then invite them by clicking on "
"this symbol:"
msgstr ""
"Pokud uživatele nenajdeš, ulož roli a pak ho pozvi kliknutím na tento symbol:"

msgid "Event Navigation"
msgstr "Navigace pro události"

msgid ""
"Manage custom navigation buttons displayed to participants for this event"
msgstr "Spravuj vlastní navigační tlačítka zobrazená účastníkům této akce"

msgid "Icon"
msgstr "Ikona"

msgid "Session"
msgstr "Relace"

msgid "Select the event of this new session"
msgstr "Vyber událost této nové relace"

msgid "Create a new session for an existing event"
msgstr "Vytvořit novou relaci pro existující událost"

msgid ""
"Edit the dates, status, and registration settings for this event session"
msgstr "Uprav data, stav a nastavení registrace pro tuto relaci akce"

msgid ""
"The event is in preparation: hidden from the homepage and calendar, only "
"staff and already registered participants can access it"
msgstr ""
"Akce je ve fázi přípravy: není zobrazena na úvodní stránce ani v kalendáři, "
"přístup k ní mají pouze členové týmu a již zaregistrovaní účastníci"

msgid ""
"The event is published: listed in the homepage and calendar, visible to all "
"users"
msgstr ""
"Událost je zveřejněna: je uvedena na úvodní stránce a v kalendáři, je "
"viditelná pro všechny uživatele"

msgid ""
"The event has taken place: archived among past events, registrations are "
"frozen"
msgstr ""
"Akce již proběhla: je zařazena mezi minulé akce, registrace jsou uzavřeny"

msgid ""
"The event will not take place: hidden from users and excluded from accounting"
msgstr ""
"Událost se neuskuteční: bude skrytá před uživateli a nebude zahrnuta do "
"výkaznictví"

msgid ""
"Participants cannot sign up: the event page shows that registrations are "
"closed"
msgstr ""
"Účastníci se nemohou přihlásit: na stránce akce je uvedeno, že registrace "
"jsou uzavřeny"

msgid "Participants can sign up right away through the registration form"
msgstr ""
"Účastníci se mohou přihlásit hned teď prostřednictvím registračního formuláře"

msgid ""
"Participants cannot sign up yet, but can pre-register to show their interest "
"and be notified when registrations open"
msgstr ""
"Účastníci se zatím nemohou přihlásit, mohou se však předběžně zaregistrovat, "
"aby projevili svůj zájem a byli informováni, až se registrace otevře"

msgid ""
"Registrations are managed on another site: participants are redirected to "
"the external link set below"
msgstr ""
"Registrace se provádějí na jiné stránce: účastníci jsou přesměrováni na "
"externí odkaz uvedený níže"

msgid ""
"Registrations stay closed until the date and time set below, then open "
"automatically"
msgstr ""
"Registrace zůstávají uzavřené až do níže uvedeného data a času, poté se "
"automaticky otevřou"

msgid ""
"Registrations are open until the date and time set below, then close "
"automatically"
msgstr ""
"Registrace jsou otevřené až do níže uvedeného data a času, poté se "
"automaticky uzavřou"

msgid ""
"Selected fields will be displayed as follows: public fields visible to all "
"participants, private fields visible only to assigned participants."
msgstr ""
"Vybraná pole se zobrazí následovně: veřejná pole vidí všichni účastníci, "
"soukromá pole vidí pouze přiřazení účastníci."

msgid "Visibility"
msgstr "Viditelnost"

msgid "Plots"
msgstr "Zápletky"

msgid "Referenced Characters"
msgstr "Odkazované postavy"

msgid "Speedlarp"
msgstr "Speedlarp"

msgid "Prologues"
msgstr "Prologi"

msgid "Workshop"
msgstr "Workshop"

msgid "Selected elements will be shown to participants."
msgstr "Vybrané prvky se zobrazí účastníkům."

msgid "Elements"
msgstr "Prvky"

msgid ""
"The secret code may only contain letters (a-z, A-Z), digits, hyphens and "
"underscores."
msgstr ""
"Tajný kód může obsahovat pouze písmena (a-z, A-Z), číslice, pomlčky a "
"podtržítka."

msgid "You need to define the end date!"
msgstr "Musíš určit datum ukončení!"

msgid "You need to define the start date!"
msgstr "Musíš určit datum zahájení!"

msgid "End date cannot be before start date!"
msgstr "Datum ukončení nesmí být před datem zahájení!"

msgid "Value required!"
msgstr "Hodnota je povinná!"

msgid "Progression"
msgstr "Postup"

msgid "Manage the progression steps shown to participants during this event"
msgstr "Spravuj kroky postupu, které se účastníkům během této akce zobrazují"

msgid ""
"Multi-event story with player-created characters, experience points, and a "
"persistent world."
msgstr ""
"Příběh pro více akcí s postavami vytvořenými hráči, zkušenostními body a "
"trvalým světem."

msgid "One-shot"
msgstr "Jednorázový"

msgid ""
"Single event focusing on narrative, characters written by staff and assigned "
"via casting algorithm, with factions and plots."
msgstr ""
"Jedna akce zaměřená na příběh, s postavami napsanými týmem a přiřazenými "
"pomocí algoritmu Casting, s frakcemi a Plot."

msgid "Manual configuration"
msgstr "Ruční konfigurace"

msgid "Choose individual features yourself"
msgstr "Vyber si jednotlivé funkce sám/sama"

msgid "Events"
msgstr "Události"

msgid "Template"
msgstr "Šablona"

msgid ""
"You can indicate a template event from which functionality and "
"configurations will be copied"
msgstr ""
"Můžeš zadat událost šablony, ze které budou zkopírovány funkce a konfigurace."

msgid "Event Template"
msgstr "Šablona události"

msgid ""
"Manage event templates used as the basis for new events, including their "
"roles and configuration"
msgstr ""
"Spravuj šablony událostí, které slouží jako základ pro nové události, včetně "
"jejich rolí a nastavení"

msgid ""
"Quickly enable or disable key features for this event using a simplified "
"checklist"
msgstr ""
"Pomocí zjednodušeného kontrolního seznamu můžeš rychle zapnout nebo vypnout "
"klíčové funkce pro tuto událost"

msgid "Do you want to manage characters assigned to registered participants?"
msgstr "Chceš spravovat postavy přiřazené registrovaným účastníkům?"

msgid "Casting algorithm"
msgstr "Algoritmus Casting"

msgid "Do you want to assign characters using a casting algorithm?"
msgstr "Chceš přiřazovat postavy pomocí castingového algoritmu?"

msgid "Do you want to allow participants to create their own characters?"
msgstr "Chceš účastníkům umožnit vytvářet vlastní postavy?"

msgid "Do you want to manage character progression through abilities?"
msgstr "Chceš spravovat postup postav pomocí schopností?"

msgid "Early registration link"
msgstr "Odkaz pro včasnou registraci"

msgid "Do you want to enable a secret registration link for early sign-ups?"
msgstr "Chceš zapnout tajný registrační odkaz pro předčasné přihlášení?"

msgid "Payment installments"
msgstr "Splátky"

msgid ""
"Do you want to split the registration fee into fixed payment installments?"
msgstr "Chceš rozdělit registrační poplatek na pevné splátky?"

msgid "Payment quotas"
msgstr "Platební splátky"

msgid ""
"Do you want to split the registration fee into dynamic payment installments?"
msgstr "Chceš rozdělit registrační poplatek na dynamické splátky?"

msgid "Voluntary donation"
msgstr "Dobrovolný příspěvek"

msgid ""
"Do you want to allow users to add a voluntary donation to their registration "
"fee?"
msgstr ""
"Chceš uživatelům umožnit přidat k registračnímu poplatku dobrovolný dar?"

msgid "Default fields"
msgstr "Výchozí pole"

msgid ""
"Select which fields should open automatically when the list is displayed"
msgstr "Vyber, která pole se mají automaticky otevřít při zobrazení seznamu"

msgid "Accounting"
msgstr "Účetnictví"

msgid "Email"
msgstr "E-mail"

msgid "Chronology"
msgstr "Chronologie"

msgid "Additional tickets"
msgstr "Další vstupenky"

msgid "Gift"
msgstr "Dárek"

msgid "Member"
msgstr "Člen"

msgid "Customisations"
msgstr "Přizpůsobení"

msgid "Surcharge"
msgstr "Příplatek"

msgid "Discounts"
msgstr "Slevy"

msgid "Traits"
msgstr "Traits"

msgid "Status"
msgstr "Stav"

msgid "XP"
msgstr "XP"

msgid "Prologue"
msgstr "Prolog"

msgid "Enter a valid number"
msgstr "Zadej platné číslo"

msgid ""
"Fill in the public metadata used to promote this event externally, including "
"language, type, setting, location, and style"
msgstr ""
"Vyplň veřejná metadata, která slouží k externí propagaci této akce, včetně "
"jazyka, typu, prostředí, místa konání a stylu"

msgid "General information"
msgstr "Obecné informace"

msgid "Languages"
msgstr "Jazyky"

msgid "Language(s) the event is held in"
msgstr "Jazyk(y), ve kterém(ých) se akce koná"

msgid "Event type"
msgstr "Typ události"

msgid "Category of the event"
msgstr "Kategorie události"

