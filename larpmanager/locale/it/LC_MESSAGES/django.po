msgstr "Quota iscrizione %(number)d di %(user)s per %(event)s"

msgid "Annual membership fee"
msgstr "Quota associativa annuale"

#, python-format
msgid "Membership fee of %(user)s for %(year)s"
msgstr "Quota associativa di %(user)s per %(year)s"

#, python-format
