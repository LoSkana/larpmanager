msgstr ""
"Voegt een pagina toe met mailinglijsten van deelnemers, gesorteerd op hun "
"nieuwsbriefvoorkeuren"

msgid "You can now review mailing lists for newsletters."
msgstr "Je kunt nu mailinglijsten voor nieuwsbrieven bekijken."

