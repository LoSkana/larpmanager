msgstr ""
"Έχεις ήδη δώσει συγκατάθεση κοινοποίησης δεδομένων σε αυτόν τον οργανισμό!"

#, python-format
msgid "You have received %(amount).2f %(elements)s for '%(reason)s'."
msgstr "Έλαβες %(amount).2f %(elements)s για '%(reason)s'."

#, python-format
msgid "A quota with %(quotas)d payments already exists for this event"
msgstr "Υπάρχει ήδη δόση με %(quotas)d πληρωμές για αυτή την εκδήλωση"

