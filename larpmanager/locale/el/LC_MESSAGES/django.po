#, python-format
msgid "Access the management panel <a href= %(url)s'>from here</a>!"
msgstr "Πρόσβαση στον πίνακα διαχείρισης <a href= %(url)s'>από εδώ</a>!"

msgid "Adds a page where you can define shorter URLs for long links"
