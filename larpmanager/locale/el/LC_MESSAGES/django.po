msgstr ""
"Διαχειρίσου τους χώρους της εκδήλωσης όπου θα τοποθετηθούν είδη αποθήκης"

#, python-format
msgid "Next payment: %(quota)s%(currency)s, overdue by %(days)s days"
msgstr ""
"Επόμενη πληρωμή: %(quota)s%(currency)s, έχει καθυστερήσει κατά %(days)s "
"ημέρες"

