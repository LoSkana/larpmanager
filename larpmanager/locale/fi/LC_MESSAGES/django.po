msgid "Style"
msgstr "Tyyli"

msgid "Choose the style for the event"
msgstr "Valitse tyyli tapahtumaa varten"

msgid "City / Place"
msgstr "Kaupunki / paikka"

msgid "City or place of the event"
msgstr "Tapahtuman kaupunki tai paikka"

msgid "Country"
msgstr "Maa"

msgid "Country of the event"
msgstr "Tapahtuman maa"

