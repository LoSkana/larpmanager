msgstr "Tämä teksti lisätään %(name)s-juonikappaleeseen lomakkeella."

msgid "View detailed activity log of all changes made for this organization"
msgstr ""
"Näytä tämän organisaation kaikkien muutosten yksityiskohtainen toimintaloki"

#, python-format
msgid "View your achievements on your <a href='%(url)s'>public profile</a>."
msgstr ""
"Voit tarkastella saavutuksiasi <a href='%(url)s'>julkisessa "
"profiilissasi</a>."

msgid "You must create at least one quest type before you can create quests"
msgstr ""
"Sinun on luotava vähintään yksi Quest-tyyppi ennen kuin voit luoda Questeja"

#, python-format
msgid "You must pay %(amount)s%(currency)s by the deadline of %(days)s days"
msgstr ""
"Sinun on maksettava %(amount)s%(currency)s viimeistään %(days)s päivän "
