msgstr "Cuota de inscripción %(number)d de %(user)s por %(event)s"

msgid "Annual membership fee"
msgstr "Cuota anual de afiliación"

#, python-format
msgid "Membership fee of %(user)s for %(year)s"
msgstr "Cuota de afiliación de %(user)s para %(year)s"

#, python-format
