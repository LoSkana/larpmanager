msgstr ""
"Ingen Safety-information har skickats in ännu. Den visas här när deltagarna "
"har angett den."

msgid ""
"Note that existing criterions with the same number, will be overwritten with"
" the uploaded data."
msgstr ""
"Observera att befintliga kriterier med samma nummer kommer att skrivas över "
"med de uppladdade uppgifterna."

#, python-format
msgid ""
"Pay the %(year)d annual membership fee of %(amount)s%(currency)s, required "
"to attend this event"
msgstr ""
"Betala medlemsavgiften för %(year)d på %(amount)s%(currency)s, som krävs för"
" att delta i detta evenemang"

#, python-format
msgid ""
"The participant <b>%(user)s</b> has requested to cancel their registration "
"for <b>%(event)s</b>"
msgstr ""
"Deltagaren <b>%(user)s</b> har begärt att få avboka sin anmälan till "
"<b>%(event)s</b>"

msgid ""
"Unique code for internal use - not visible. Indicate a string without spaces"
