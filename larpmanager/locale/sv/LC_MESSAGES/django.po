msgstr ""
"Du har blivit inbjuden att ansluta dig till rollen "
"<strong>%(role.name)s</strong> inom organisationen."

#, python-format
msgid ""
"A minimum payment of <b>%(amount).2f %(currency)s</b> is required within "
"%(deadline)d days."
msgstr ""
"En minimibetalning på <b>%(amount).2f %(currency)s</b> måste erläggas inom "
"%(deadline)d dagar."

msgid ""
"Create a ticket type by clicking 'New'; set the name, price, and "
