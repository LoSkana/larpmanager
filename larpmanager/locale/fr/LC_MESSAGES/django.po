msgid ""
"You are authenticated as %(username)s, but are not authorized to access this "
"page. Would you like to login to a different account?"
msgstr ""
"Tu es authentifié en tant que %(username)s, mais tu n'es pas autorisé à "
"accéder à cette page. Souhaites-tu te connecter avec un autre compte ?"

msgid "Forgotten your password or username?"
msgstr "Tu as oublié ton mot de passe ou ton nom d'utilisateur ?"

msgid "Two-Factor Authentication"
msgstr "Authentification à deux facteurs"

msgid "Enter the 6-digit code from your authenticator app."
msgstr "Saisis le code à 6 chiffres de ton application d'authentification."

msgid "Verify"
msgstr "Vérifier"

msgid "Password changed"
msgstr "Mot de passe modifié"

msgid "Password reset confirmed"
msgstr "Réinitialisation du mot de passe confirmée"

msgid "Failed password reset"
msgstr "La réinitialisation du mot de passe a échoué"

